# ===========================================
# VARIABLES DE ENTORNO - Autoescuela Virtual
# ===========================================

# Puerto del servidor (default: 3001)
PORT=3001

# Clave secreta para firmar tokens JWT
# IMPORTANTE: Genera un valor seguro y NUNCA lo subas a git
# Ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_aqui

# Origins permitidos para CORS (separados por coma)
# En desarrollo: http://localhost:5173
# En producción: https://tu-dominio.com
CORS_ORIGIN=http://localhost:5173

# Modo: development | production
NODE_ENV=development

# Ruta de la base de datos (opcional, default: ./data/autoescuela.db)
# DB_PATH=./data/autoescuela.db
